{
  "name": "self-hosted-control-center",
  "version": "0.3.1",
  "description": "A local-first, settings-driven business intelligence dashboard.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "launch": "node scripts/launch.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "ingest": "node scripts/ingest.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "packageManager": "npm@11.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mreflow/control-center.git"
  },
  "homepage": "https://github.com/mreflow/control-center#readme",
  "bugs": {
    "url": "https://github.com/mreflow/control-center/issues"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
